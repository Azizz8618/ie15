#!/bin/sh
# Эмулятор терминала «Электроника 15ИЭ-00-013»: интерактивный сеанс.
#
# Двойной щелчок / запуск без аргументов — диалог с БЭСМ-6 на линии
# tcp://127.0.0.1:4202, сеанс длится до Ctrl-C, окно не закрывается само.
#
# Варианты:
#   ./ie15 --line ssh://ie15@127.0.0.1:2222 --password ie15   # через SSH-мост
#   ./ie15 --mode local                                       # АВТОНОМНО, F10=SEND
#   ./ie15 --script demo                                      # без сети, демо экрана
#
# Русские буквы набираются с любой раскладки (нужен UTF-8-терминал);
# --koi7 — русская раскладка: QWERTY-клавиши печатают по-русски,
# с залитым Shift — по-английски.
cd "$(dirname "$0")" || exit 1
pause=0
[ $# -eq 0 ] && pause=1
case " $* " in
  *--line*|*--script*|*--help*) ;;
  *) set -- --line tcp://127.0.0.1:4202 "$@" ;;
esac
case " $* " in
  *" --seconds "*|*" --seconds="*) ;;
  *) set -- --seconds 0 "$@" ;;
esac
python3 -m ie15emu "$@"
rc=$?
if [ "$pause" = 1 ] && [ -t 0 ]; then
    printf '\nСеанс завершён (код %s). Нажми Enter, чтобы закрыть: ' "$rc"
    read _ 2>/dev/null || true
fi
exit $rc
